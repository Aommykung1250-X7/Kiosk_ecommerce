# Copy to a root .env for local Compose commands, or enter these in Portainer.
# Production image references must include a registry/owner and a fixed release tag.
KIOSK_WEB_IMAGE=
KIOSK_API_IMAGE=
WEB_PORT=11780
APP_ORIGIN=http://ditckiosk.camt.cmu.ac.th

DB_NAME=kiosk_db
DB_USER=ditc_kiosk
DB_PASSWORD=
# Generate a separate JWT secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional email settings. No payment credentials are needed for this deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=
# Checkout and payment webhooks stay disabled until Krungthai is integrated.
